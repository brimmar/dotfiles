{
  "zellij-orchestrator": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "/home/brimmar/.local/bin/zmux-agy-hook pre-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-agy-hook pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-agy-hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "/home/brimmar/.local/bin/zmux-agy-hook post-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/home/brimmar/.local/bin/zmux-agy-hook stop",
        "timeout": 5
      }
    ]
  }
}
