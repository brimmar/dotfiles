{
  "description": "Zellij AI Orchestration lifecycle event hooks for Codex",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook permission-request",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/brimmar/.local/bin/zmux-codex-hook stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
