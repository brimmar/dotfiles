#!/usr/bin/env node
// zmux-codex-hook: Native Codex CLI lifecycle event hook handler for Zellij AI Orchestration
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';

const eventType = process.argv[2] || 'user-prompt';
const tabId = process.env.ZELLIJ_TAB_ID || '0';
const paneId = process.env.ZELLIJ_PANE_ID || '0';

function emit(state, message) {
  const agentDir = '/tmp/zellij_agents';
  try {
    if (!fs.existsSync(agentDir)) fs.mkdirSync(agentDir, { recursive: true });
    const payload = JSON.stringify({
      pane_id: paneId,
      tab_id: tabId,
      engine: 'codex',
      state: state,
      message: message || state,
      pid: process.pid,
      time: Math.floor(Date.now() / 1000)
    });
    fs.writeFileSync(`${agentDir}/event_pane_${paneId}.json`, payload);
  } catch (e) {}

  if (process.env.ZELLIJ) {
    const safeMsg = (message || state).replace(/"/g, '\\"');
    const args = ['emit', state, 'codex', safeMsg, tabId, paneId, String(process.pid)];
    try {
      spawnSync('/home/brimmar/.local/bin/zmux', args, {
        stdio: 'ignore'
      });
    } catch (e) {}
  }
}

// Read stdin synchronously if piped
let inputData = {};
try {
  if (!process.stdin.isTTY) {
    const raw = fs.readFileSync(0, 'utf8');
    if (raw && raw.trim()) {
      inputData = JSON.parse(raw);
    }
  }
} catch (e) {}

switch (eventType) {
  case 'session-start':
    emit('ready', 'Ready');
    process.stdout.write(JSON.stringify({}) + '\n');
    break;

  case 'user-prompt':
    emit('working', 'Thinking...');
    process.stdout.write(JSON.stringify({}) + '\n');
    break;

  case 'pre-tool': {
    const toolName = inputData.tool_name || 'tool';
    emit('working', `Tool: ${toolName}`);
    process.stdout.write(JSON.stringify({}) + '\n');
    break;
  }

  case 'permission-request':
    emit('needs_input', 'Awaiting approval');
    process.stdout.write(JSON.stringify({}) + '\n');
    break;

  case 'post-tool':
    emit('working', 'Processing...');
    process.stdout.write(JSON.stringify({}) + '\n');
    break;

  case 'stop':
    emit('ready', 'Ready');
    process.stdout.write(JSON.stringify({}) + '\n');
    break;

  default:
    process.stdout.write(JSON.stringify({}) + '\n');
    break;
}

process.exit(0);
