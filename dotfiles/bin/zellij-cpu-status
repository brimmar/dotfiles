#!/usr/bin/env bash
# Ultra-fast pure-bash CPU usage without sleep or external forks
CACHE_FILE="/tmp/zellij_cpu_last.stat"

read -r _ u n s i w ir so st _ < /proc/stat 2>/dev/null || exit 0
idle=$((i + w))
total=$((u + n + s + i + w + ir + so + st))

if [ -f "$CACHE_FILE" ]; then
    read -r prev_idle prev_total < "$CACHE_FILE" 2>/dev/null || true
    echo "$idle $total" > "$CACHE_FILE"

    diff_idle=$((idle - prev_idle))
    diff_total=$((total - prev_total))

    if [ "$diff_total" -gt 0 ]; then
        usage=$(( (100 * (diff_total - diff_idle)) / diff_total ))
        [ "$usage" -lt 0 ] && usage=0
        [ "$usage" -gt 100 ] && usage=100
        echo "$usage"
    else
        echo "0"
    fi
else
    echo "$idle $total" > "$CACHE_FILE"
    echo "0"
fi
