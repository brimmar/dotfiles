layout {
	pane size=1 borderless=true {
		plugin location="https://github.com/brimmar/zjstatus/releases/download/v0.24.1/zjstatus.wasm" {
			format_left "{mode}#[bg=#2C2C2C] {tabs}"
			format_center "#[fg=9399B2,bold,bg=#2C2C2C]{session}"
			format_right "{command_agent_status}{command_timer_status} {command_cpu_usage} {command_memory_usage} {command_disk_usage} {datetime}"
			format_space "#[bg=#2C2C2C]"

			mode_normal "#[bg=#7bf1a8,fg=black] 󰀘 "
			mode_tab "#[bg=#ffadad,fg=black] 󰀘 "
			mode_pane "#[bg=#fdffb6,fg=black] 󰀘 "
			mode_locked "#[bg=#2C2C2C,bold]   {name} "
			mode_resize "#[bg=#a0c4ff,fg=black] 󰀘 "
			mode_scroll "#[bg=#bdb2ff,fg=black] 󰀘 "
			mode_session "#[bg=#ffc6ff,fg=black] 󰀘 "
			mode_move "#[bg=#9bf6ff,fg=black] 󰀘 "
			mode_search "#[bg=#ffd6a5,fg=black] 󰀘 "
			mode_entersearch "#[bg=#ffd6a5,fg=black] 󰀘 "
			mode_renametab "#[bg=#ffadad,fg=black] 󰀘 "
			mode_renamepane "#[bg=#fdffb6,fg=black] 󰀘 "

			pipe_agent_status_format "{output}"
			pipe_agent_status_rendermode "dynamic"

			command_agent_status_command "/home/brimmar/.local/bin/zellij-agent-status"
			command_agent_status_format "{stdout} "
			command_agent_status_interval "1"
			command_agent_status_rendermode "dynamic"
			command_agent_status_hide_on_empty_stdout "true"

			command_cpu_usage_command "/home/brimmar/.local/bin/zellij-cpu-status"
			command_cpu_usage_format "#[fg=#a6e3a1]▎󰻠 {stdout}%"
			command_cpu_usage_interval "3"
			command_cpu_usage_rendermode "static"

			command_memory_usage_command "/home/brimmar/.local/bin/zellij-memory-status"
			command_memory_usage_format "#[fg=#FFADAD]▎󰍛 {stdout}%"
			command_memory_usage_interval "10"
			command_memory_usage_rendermode "static"

			command_disk_usage_command "/home/brimmar/.local/bin/zellij-disk-status"
			command_disk_usage_format "#[fg=#caffbf]▎󰗮 {stdout}"
			command_disk_usage_interval "60"
			command_disk_usage_rendermode "static"

			command_timer_status_command "/home/brimmar/.local/bin/zellij-timer-status"
			command_timer_status_format "#[fg=#F38BA8] {stdout}"
			command_timer_status_interval "1"
			command_timer_status_rendermode "static"
			command_timer_status_hide_on_empty_stdout "true"

			tab_normal "#[fg=#6C7086,bg=#2C2C2C]  {name}  "
			tab_active "#[bg=#2C2C2C,fg=#1f2227]#[fg=#cdd6f4,bold] {name} #[bg=#2C2C2C,fg=#1f2227]"
			tab_sync_active "#[bg=#2C2C2C,fg=#1f2227]#[fg=#7bf1a8,bold] 󰓦 {name} #[bg=#2C2C2C,fg=#1f2227]"
			tab_sync_normal "#[fg=#7bf1a8,bg=#2C2C2C]  󰓦 {name}  "
			tab_fullscreen_active "#[bg=#2C2C2C,fg=#1f2227]#[fg=#fdffb6,bold] 󰊓 {name} #[bg=#2C2C2C,fg=#1f2227]"
			tab_floating_active "#[bg=#2C2C2C,fg=#1f2227]#[fg=#a0c4ff,bold] 󰉈 {name} #[bg=#2C2C2C,fg=#1f2227]"

			datetime "#[fg=#9399B2,bold]▎󰃭 {format} "
			datetime_format "%A, %d %b %Y 󰥔 %H:%M"
			datetime_timezone "America/Sao_Paulo"
			datetime_locale "pt_BR"
		}
	}
	pane
}
