{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"plugin": [
		"/home/brimmar/.config/opencode/plugins/zellij-orchestrator/plugin.js"
	],
	"mcp": {
		"brave": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"chrome-devtools-mcp@latest",
				"--executablePath=/usr/bin/brave-browser",
				"--userDataDir=/home/brimmar/.cache/chrome-devtools-mcp/opencode",
				"--no-usage-statistics",
				"--ignoreDefaultChromeArg=--enable-automation",
				"--ignoreDefaultChromeArg=--password-store=basic",
				"--chromeArg=--disable-blink-features=AutomationControlled",
				"--chromeArg=--no-default-browser-check"
			],
			"enabled": true,
			"environment": {}
		}
	},
	"permission": {
		"edit": "ask",
		"bash": {
			"*": "ask",
			"find": "allow",
			"find *": "allow",
			"ls": "allow",
			"ls *": "allow",
			"sort": "allow",
			"sort *": "allow",
			"head": "allow",
			"head *": "allow",
			"tail": "allow",
			"tail *": "allow",
			"less": "allow",
			"less *": "allow",
			"more": "allow",
			"more *": "allow",
			"wc": "allow",
			"wc *": "allow",
			"du": "allow",
			"du *": "allow",
			"df": "allow",
			"df *": "allow",
			"pwd": "allow",
			"which": "allow",
			"which *": "allow",
			"whoami": "allow",
			"id": "allow",
			"date": "allow",
			"date *": "allow",
			"stat": "allow",
			"stat *": "allow",
			"file": "allow",
			"file *": "allow",
			"env": "allow",
			"printenv": "allow",
			"printenv *": "allow",
			"history": "allow",
			"ps": "allow",
			"ps *": "allow",
			"uname": "allow",
			"uname *": "allow",
			"uptime": "allow",
			"dirname": "allow",
			"dirname *": "allow",
			"basename": "allow",
			"basename *": "allow",
			"realpath": "allow",
			"realpath *": "allow",
			"type": "allow",
			"type *": "allow",
			"tty": "allow",
			"nproc": "allow",
			"arch": "allow",
			"hostname": "allow",
			"who": "allow",
			"who *": "allow",
			"w": "allow"
		},
		"write": "ask",
		"patch": "ask"
	}
}
